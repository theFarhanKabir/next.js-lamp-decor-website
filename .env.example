NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Standalone API used for admin operations, payments and courier management.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
# Current server-only key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy fallback for projects that still use the service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only MiMSMS transactional SMS settings for Supabase phone OTPs.
MIMSMS_USERNAME=
MIMSMS_API_KEY=
MIMSMS_SENDER_NAME=
# Copy the full v1,whsec_... signing secret from Supabase Authentication > Hooks.
SUPABASE_SEND_SMS_HOOK_SECRETS=
# Optional SSLCOMMERZ hosted checkout. Keep both credentials server-only.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# Optional random token configured in the Steadfast webhook settings
STEADFAST_WEBHOOK_TOKEN=
PUBLIC_API_URL=
PUBLIC_SITE_URL=http://localhost:3000
