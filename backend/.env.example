PORT=4000
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000
# Set true only when a trusted reverse proxy removes incoming forwarded headers and writes its own.
TRUST_PROXY=false

# Leave blank until you are ready to connect a Supabase project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Current server-only key. Never expose it to browser code.
SUPABASE_SECRET_KEY=
# Legacy fallback for projects that still use the service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=

STORE_MEDIA_BUCKET=store-media
CUSTOM_REFERENCE_BUCKET=custom-request-references
MAX_IMAGE_BYTES=12582912
MAX_JSON_BYTES=1048576

# Optional online payments. Keep the store password server-only.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# Optional random token configured in the Steadfast webhook settings
STEADFAST_WEBHOOK_TOKEN=
# Public HTTPS URL for this Node API (needed for callbacks/IPN).
PUBLIC_API_URL=
# Public storefront URL; a localhost URL is okay for local sandbox testing.
PUBLIC_SITE_URL=http://localhost:3000
