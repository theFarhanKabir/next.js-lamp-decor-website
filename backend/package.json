{
  "name": "cloud-lamps-store-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <27"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.mjs",
